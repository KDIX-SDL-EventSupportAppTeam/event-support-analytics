# event-support-analytics の環境変数の例。
#
# 使い方: このファイルを `.env` にコピーして値を埋める（`.env` は .gitignore 済み）。
# ローカルでは `set -a; . ./.env; set +a` などで読み込む。Cloud Run では
# Secret Manager / 環境変数として注入する（docs/operations/deploy.md）。
#
# **秘密の実値をこのファイルに書かないこと。** ここにあるのは名前と説明だけ。

# --- 画面の合言葉（共有アクセス制御。src/auth.py）--------------------------
# 未設定ならローカル実行では素通りする。Cloud Run では必ず設定する。
DASHBOARD_PASSWORD=

# --- 推薦エンジンの /ops/state と /demo（issue #18・推薦側 ADR 0008）------
# base URL。当日 URL を手打ちさせないための既定値。`/ops/state` と `/demo` を組み立てる。
RECOMMEND_BASE_URL=
# `/ops/*` の認証トークン。ヘッダは X-Ops-Token（Authorization は使わない）。
# **推薦サービスの OPS_TOKEN と同一の秘密**（Secret Manager の同じシークレットを渡す）。
# 読み取り専用プロキシの鍵（REC_READONLY_PROXY_KEY）とは**別物**。使い回さない。
# 未設定なら /ops/state を叩かず「未設定」と表示する（401「誤り」と区別。issue #18 T-2）。
RECOMMEND_OPS_TOKEN=

# --- 本番 MySQL 読み取り専用プロキシ（ADR 0001・issue #9）----------------
# さくら上の PHP ラッパー API に足した読み取り専用の口。設定すると rec_db.SqlSource が本番を読む。
# **書き込み可能な SAKURA_PROXY_* は使わない**（全権のため。ADR 0001 案A の欠点）。
REC_READONLY_PROXY_URL=
REC_READONLY_PROXY_KEY=

# --- 推薦エンジンの features/ を import するためのパス（src/rec_features.py）
# event-support-recommend リポジトリのルート。条件属性・interest_match の計算をコピーしない。
REC_FEATURES_PATH=

# --- 推薦の2画面が読むデータのディレクトリ（既定は合成データ）--------------
REC_DATA_DIR=data/synth
